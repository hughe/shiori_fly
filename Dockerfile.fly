# Copy shiori from official image
#
# The Shiori version is a build arg so test and prod differ only by
# their fly toml ([build.args] SHIORI_VERSION).
#
# Prod is pinned to v1.7.4 for now. v1.8.0 dropped the X-Session-Id
# header (only Authorization: Bearer / the token cookie are accepted),
# which broke Shiori Share. That was the "bug" in
# https://github.com/go-shiori/shiori/issues/1176 (closed as a client
# auth problem). Move to v1.8.0 once Shiori Share sends Bearer; see
# TODO.md.
ARG SHIORI_VERSION=v1.7.4
FROM ghcr.io/go-shiori/shiori:${SHIORI_VERSION} AS shiori-source

# Build on Alpine
#
# The Shiori source container is a distro-less container. It basically
# only contains the Shiori binary and the files named below. For
# debugging, I really want something that's at least got a very small
# distro in it and a shell.
FROM alpine:3.24

# Copy shiori binary and dependencies from official image
COPY --from=shiori-source /usr/bin/shiori /usr/bin/shiori
COPY --from=shiori-source /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=shiori-source /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Install bash and utilities. sqlite is for inspecting / checking /
# backing up the database (e.g. sqlite3 shiori.db "PRAGMA integrity_check;"
# or ".backup" for a consistent copy while Shiori is running).
RUN apk add --no-cache bash tar bzip2 sqlite

# Set environment
ENV PORT=8080

# The volume should be mounted here.
ENV SHIORI_DIR=/mnt/shiori

WORKDIR ${SHIORI_DIR}

# Expose port
EXPOSE ${PORT}

ENTRYPOINT ["/usr/bin/shiori"]
CMD ["server"]
